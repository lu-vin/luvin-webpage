---
import '@fontsource-variable/inter/index.css'
import '../styles/global.css'
import Wordmark from '../components/Wordmark.astro'
import { strings, type Lang } from '../i18n/strings'
import { commerce } from '../i18n/commerce'
import { commercePages, commerceVisible } from '../lib/commerce'

interface Props {
  lang: Lang
  /** Ruta de la página después de la raíz del idioma, por ejemplo 'compare/postman-flows/'. */
  path?: string
  title?: string
  description?: string
}
const { lang, path = '' } = Astro.props
const t = strings[lang]
const title = Astro.props.title ?? t.meta.title
const description = Astro.props.description ?? t.meta.description
const home = lang === 'en' ? '/' : '/es/'
const other = (lang === 'en' ? '/es/' : '/') + path
const canonical = new URL(home + path, Astro.site)
const og = new URL(`/media/og-${lang}.jpg`, Astro.site)
// Las páginas del sitio; la actual se marca en el menú (la primera parte de `path`).
const links = [
  { id: 'product', label: t.nav.product },
  { id: 'compare', label: t.nav.compare },
  { id: 'about', label: t.nav.about },
  { id: 'faq', label: t.nav.faq },
]
const current = path.split('/')[0]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a110d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/' + path, Astro.site)} />
    <link rel="alternate" hreflang="es" href={new URL('/es/' + path, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Con JavaScript, las secciones aparecen al entrar en pantalla (sin él se ven desde el principio). -->
    <script is:inline>document.documentElement.classList.add('js')</script>
    {
      // Los enlaces de antes (todo en una página): /#faq, /#founders… llevan a su página nueva.
      path === '' && (
        <script is:inline define:vars={{ home }}>
          var moved = { chains: 'product/#chains', client: 'product/#client', features: 'product/#features', compare: 'compare/', faq: 'faq/', founders: 'about/' }
          var to = moved[location.hash.slice(1)]
          if (to) location.replace(home + to)
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href={home} aria-label="Luvin">
          <img src="/logo.svg" width="32" height="32" alt="" />
          <Wordmark size={26} />
        </a>
        <nav class="nav" aria-label="Main">
          {links.map((l) => (
            <a href={`${home}${l.id}/`} aria-current={current === l.id ? 'page' : undefined}>
              {l.label}
            </a>
          ))}
          {/* Precios: solo con `npm run dev` hasta que se abra la venta (src/lib/commerce.ts). */}
          {commerceVisible && <a href={`${home}pricing/`}>{commerce[lang].footer.pricing}</a>}
        </nav>
        <div class="header-actions">
          <a class="lang" href={other} hreflang={lang === 'en' ? 'es' : 'en'}>{t.nav.switchLang}</a>
          <a class="btn btn-primary btn-sm" href="#waitlist">{t.nav.waitlist}</a>
          <details class="menu">
            <summary aria-label={t.nav.menu}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </summary>
            <nav class="menu-panel" aria-label={t.nav.menu}>
              {links.map((l) => (
                <a href={`${home}${l.id}/`} aria-current={current === l.id ? 'page' : undefined}>
                  {l.label}
                </a>
              ))}
              {commerceVisible && <a href={`${home}pricing/`}>{commerce[lang].footer.pricing}</a>}
              <a href={other} hreflang={lang === 'en' ? 'es' : 'en'}>{t.nav.switchLang}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-row">
        <div class="brand">
          <img src="/logo.svg" width="28" height="28" alt="" />
          <Wordmark size={22} />
        </div>
        <p class="footer-tagline">{t.footer.tagline}</p>
        <nav class="footer-links footer-site" aria-label={t.nav.menu}>
          <a href={home}>{t.nav.home}</a>
          {links.map((l) => <a href={`${home}${l.id}/`}>{l.label}</a>)}
          <a href={`${home}compare/postman-flows/`}>Luvin vs {t.flows.flowsLabel}</a>
        </nav>
        {
          // Precios y páginas legales: solo con `npm run dev` hasta que se abra la venta (src/lib/commerce.ts).
          commerceVisible && (
            <nav class="footer-links" aria-label={commerce[lang].footer.terms}>
              {commercePages.map((page) => (
                <a href={`${home}${page}/`}>{commerce[lang].footer[page]}</a>
              ))}
            </nav>
          )
        }
        <p class="fine">© 2026 Luvin · {t.footer.specs}</p>
        {commerceVisible && <p class="fine">{commerce[lang].footer.seller}</p>}
      </div>
    </footer>
    <script>
      // El menú del teléfono se cierra al elegir una sección; la cabecera se marca al bajar.
      const menu = document.querySelector<HTMLDetailsElement>('.menu')
      menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.removeAttribute('open')))
      const header = document.querySelector('.site-header')
      const onScroll = () => header?.classList.toggle('scrolled', scrollY > 8)
      addEventListener('scroll', onScroll, { passive: true })
      onScroll()

      // Lo que entra en pantalla aparece con una animación corta, y los videos de la app se reproducen
      // solo mientras se ven (así no se descargan todos al abrir la página).
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      const seen = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            e.target.classList.add('in')
            seen.unobserve(e.target)
          }
        },
        { rootMargin: '0px 0px -8% 0px' },
      )
      document.querySelectorAll('.reveal').forEach((el) => seen.observe(el))
      const clips = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement
            if (e.isIntersecting && !reduced) void v.play().catch(() => {})
            else v.pause()
          }
        },
        { threshold: 0.35 },
      )
      document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
        if (reduced) v.controls = true
        clips.observe(v)
      })
    </script>
  </body>
</html>
