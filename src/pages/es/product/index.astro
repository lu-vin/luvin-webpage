---
import Base from '../../../layouts/Base.astro'
import Showcase from '../../../components/sections/Showcase.astro'
import Chains from '../../../components/sections/Chains.astro'
import Client from '../../../components/sections/Client.astro'
import Features from '../../../components/sections/Features.astro'
import Waitlist from '../../../components/sections/Waitlist.astro'
import PageHead from '../../../components/PageHead.astro'
import { strings } from '../../../i18n/strings'

const lang = 'es'
const t = strings[lang]
const meta = t.pages.product
---

<Base lang={lang} path="product/" title={meta.metaTitle} description={meta.metaDescription}>
  <PageHead kicker={t.pages.product.kicker} title={t.pages.product.title} lead={t.pages.product.lead} />
  <Showcase lang={lang} />
  <Chains lang={lang} />
  <Client lang={lang} />
  <Features lang={lang} />
  <Waitlist lang={lang} />
</Base>
