---
// Escena 2 de /product: del contrato a la cadena. En pantallas anchas el lienzo queda fijo y el
// scroll lo lleva por cuatro estados: el contrato, sus operaciones, los pasos y las conexiones.
// En el teléfono los cuatro textos van en lista y el lienzo muestra el resultado.
import SceneCanvas from './SceneCanvas.astro'
import { layout, STEPS } from '../../lib/scene'
import { strings, type Lang } from '../../i18n/strings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = strings[lang].pages.story.build
const L = layout('wide')
const u = (n: number) => `calc(var(--u) * ${n})`

// Las operaciones del contrato: las tres del workflow quedan sobre su paso.
const used = STEPS.map((st, i) => ({ id: st.id, method: st.method, path: st.path, x: L.boxes[i].x + 10, y: 70, used: true }))
const others = [
  { id: 'getAccount', method: 'GET', path: '/accounts/{accountId}' },
  { id: 'createTransfer', method: 'POST', path: '/transfers' },
  { id: 'signOut', method: 'DELETE', path: '/sessions' },
].map((o, i) => ({ ...o, x: L.boxes[i].x + 10, y: 152, used: false }))
const ops = [...used, ...others]
const yaml = [
  ['openapi', ': 3.1.0'],
  ['info', ': { title: Bank API }'],
  ['paths', ':'],
  ['  /login', ':'],
  ['    post', ': { operationId: signIn }'],
  ['  /customers/{customerId}', ':'],
  ['    get', ': { operationId: getCustomer }'],
  ['  /accounts', ':'],
  ['    post', ': { operationId: openAccount }'],
  ['  /transfers', ':'],
  ['    post', ': { operationId: createTransfer }'],
]
---

<section class="st-build" data-s="3">
  <div class="st-sticky">
    <div class="container st-build-inner">
      <p class="kicker st-center">{s.kicker}</p>
      <div class="st-caps">
        {
          s.steps.map((c, i) => (
            <div class="st-cap" data-k={i}>
              <span class="st-cap-n">{i + 1}</span>
              <h2>{c.title}</h2>
              <p>{c.body}</p>
            </div>
          ))
        }
      </div>
      <ol class="st-dots" aria-hidden="true">{s.steps.map(() => <li />)}</ol>
      <div class="st-build-stage">
        <SceneCanvas lang={lang} id="build-w" variant="wide" label={s.label} class="st-only-wide">
          <div class="st-contract" style={`left:${u(290)}; top:${u(14)}; width:${u(420)}`}>
            <div class="st-contract-bar"><span></span><span></span><span></span><b>bank.openapi.yaml</b></div>
            <pre>{yaml.map(([k, v]) => <span><i>{k}</i>{v}{'\n'}</span>)}</pre>
          </div>
          {
            ops.map((o, i) => (
              <div
                class:list={['st-op', { 'st-op-used': o.used }]}
                style={`--j:${i}; left:${u(o.x)}; top:${u(o.y)}; width:${u(250)}`}>
                <span class={`sc-m sc-${o.method.toLowerCase()} st-op-m`}>{o.method}</span>
                <span class="st-op-text">
                  <b>{o.id}</b>
                  <code>{o.path}</code>
                </span>
              </div>
            ))
          }
          <p class="st-wired" style={`top:${u(L.H + 14)}`}>{s.wired}</p>
        </SceneCanvas>
        <SceneCanvas lang={lang} id="build-t" variant="tall" label={s.label} class="st-only-tall" />
      </div>
    </div>
  </div>
</section>

<script>
  // El estado sigue al scroll en pantallas anchas; en el teléfono, el lienzo se conecta al entrar en pantalla.
  const section = document.querySelector<HTMLElement>('.st-build')
  if (section) {
    const wide = matchMedia('(min-width: 861px)')
    let frame = 0
    const update = () => {
      frame = 0
      if (!wide.matches) return
      const r = section.getBoundingClientRect()
      const run = section.offsetHeight - innerHeight
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, run)))
      section.dataset.s = String(Math.min(3, Math.floor(p * 4)))
    }
    addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true })
    wide.addEventListener('change', update)
    // Sin JavaScript se ve el resultado; con él, se arma: el teléfono espera a ver el lienzo.
    if (!wide.matches) section.dataset.s = '2'
    update()
    new IntersectionObserver(
      (entries) => entries.forEach((e) => e.isIntersecting && !wide.matches && (section.dataset.s = '3')),
      { threshold: 0.25 },
    ).observe(section.querySelector('.st-only-tall')!)
  }
</script>

<style is:global>
  .st-build { position: relative; height: 420vh; background: var(--bg-alt); border-block: 1px solid var(--line); }
  .st-sticky { position: sticky; top: 68px; height: calc(100vh - 68px); display: grid; align-items: center; overflow: hidden; }
  .st-build-inner { display: grid; justify-items: center; }
  .st-center { text-align: center; }
  .st-caps { display: grid; width: 100%; text-align: center; }
  .st-cap { grid-area: 1 / 1; opacity: 0; transform: translateY(16px); transition: opacity .5s, transform .5s; }
  .st-cap h2 { font-size: clamp(32px, 4.6vw, 60px); letter-spacing: -.035em; }
  .st-cap p { margin-top: 12px; color: var(--muted); font-size: clamp(17px, 1.6vw, 21px); }
  .st-cap-n { display: none; }
  .st-build[data-s='0'] .st-cap[data-k='0'], .st-build[data-s='1'] .st-cap[data-k='1'],
  .st-build[data-s='2'] .st-cap[data-k='2'], .st-build[data-s='3'] .st-cap[data-k='3'] { opacity: 1; transform: none; }
  .st-dots { display: flex; gap: 8px; margin-top: 22px; }
  .st-dots li { width: 28px; height: 4px; border-radius: 2px; background: var(--line-hi); transition: background .4s; }
  .st-build[data-s='0'] .st-dots li:nth-child(-n + 1), .st-build[data-s='1'] .st-dots li:nth-child(-n + 2),
  .st-build[data-s='2'] .st-dots li:nth-child(-n + 3), .st-build[data-s='3'] .st-dots li { background: var(--node); }
  .st-build-stage { width: min(100%, 1080px, calc((100vh - 68px - 330px) * 1000 / 354)); margin-top: 36px; }

  /* El contrato */
  .st-contract {
    position: absolute; z-index: 3; border-radius: calc(var(--u) * 14); overflow: hidden;
    background: #0b120e; border: 1px solid #2f4237; box-shadow: 0 calc(var(--u) * 30) calc(var(--u) * 80) rgba(0, 0, 0, .55), 0 0 calc(var(--u) * 60) rgba(111, 207, 127, .08);
    transition: opacity .6s, transform .7s cubic-bezier(.2, .7, .2, 1), filter .6s;
  }
  .st-contract-bar { display: flex; align-items: center; gap: calc(var(--u) * 6); padding: calc(var(--u) * 10) calc(var(--u) * 14); border-bottom: 1px solid #223028; }
  .st-contract-bar span { width: calc(var(--u) * 9); height: calc(var(--u) * 9); border-radius: 50%; background: #2f4237; }
  .st-contract-bar b { margin-left: calc(var(--u) * 8); color: var(--muted); font: 600 calc(var(--u) * 12) / 1 ui-monospace, 'SF Mono', Menlo, monospace; }
  .st-contract pre { margin: 0; padding: calc(var(--u) * 12) calc(var(--u) * 16) calc(var(--u) * 16); color: var(--muted); font: 500 calc(var(--u) * 13) / 1.62 ui-monospace, 'SF Mono', Menlo, monospace; white-space: pre; }
  .st-contract i { font-style: normal; color: var(--node); }

  /* Las operaciones */
  .st-op {
    position: absolute; z-index: 3; display: flex; align-items: center; gap: calc(var(--u) * 10); height: calc(var(--u) * 56); padding: 0 calc(var(--u) * 12);
    border-radius: calc(var(--u) * 12); background: #111a15; border: 1px solid #2f4237; box-shadow: 0 calc(var(--u) * 14) calc(var(--u) * 34) rgba(0, 0, 0, .4);
    opacity: 0; transform: translateY(calc(var(--u) * 26)) scale(.94);
    transition: opacity .5s calc(var(--j) * .05s), transform .6s cubic-bezier(.2, .7, .2, 1) calc(var(--j) * .05s), border-color .3s;
  }
  .st-op-m { flex: none; }
  .sc-delete { background: #e5484d; }
  .st-op-text { display: grid; min-width: 0; }
  .st-op-text b { font-size: calc(var(--u) * 14); }
  .st-op-text code { color: var(--muted); font: 500 calc(var(--u) * 11.5) / 1.3 ui-monospace, 'SF Mono', Menlo, monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .st-wired {
    position: absolute; left: 50%; z-index: 3; transform: translateX(-50%); padding: calc(var(--u) * 8) calc(var(--u) * 16); border-radius: 999px;
    color: #e9dcff; background: rgba(181, 140, 255, .12); border: 1px solid rgba(181, 140, 255, .4); font: 600 calc(var(--u) * 13.5) / 1 ui-monospace, 'SF Mono', Menlo, monospace; white-space: nowrap;
    opacity: 0; transition: opacity .5s .9s;
  }

  /* Los pasos y las líneas, por estado */
  .st-build .sc-node { opacity: 0; transform: translateY(calc(var(--u) * 30)) scale(.96); transition: opacity .6s calc(var(--i) * .12s), transform .7s cubic-bezier(.2, .7, .2, 1) calc(var(--i) * .12s); }
  .st-build .sc-draw { stroke-dashoffset: 1; transition: stroke-dashoffset 1s cubic-bezier(.45, 0, .2, 1) calc(.2s + var(--k) * .16s); }
  .st-build .sc-pill { opacity: 0; transform: scale(.8); }
  .st-build:not([data-s='0']) .st-contract { opacity: 0; transform: scale(1.06); filter: blur(6px); }
  .st-build[data-s='1'] .st-op { opacity: 1; transform: none; }
  .st-build[data-s='2'] .st-op-used, .st-build[data-s='3'] .st-op-used { opacity: 0; transform: translateY(calc(var(--u) * -34)) scale(1.08); }
  .st-build[data-s='2'] .sc-node, .st-build[data-s='3'] .sc-node { opacity: 1; transform: none; }
  .st-build[data-s='3'] .sc-draw { stroke-dashoffset: 0; }
  .st-build[data-s='3'] .sc-pill { opacity: 1; transform: none; transition-delay: calc(.5s + var(--i, 0) * .12s); }
  .st-build[data-s='3'] .st-wired { opacity: 1; }

  /* Teléfono: sin fijar, los cuatro textos en lista */
  @media (max-width: 860px) {
    .st-build { height: auto; padding: 76px 0; }
    .st-sticky { position: static; height: auto; overflow: visible; }
    .st-caps { gap: 22px; text-align: left; }
    .st-cap { grid-area: auto; opacity: 1; transform: none; display: grid; grid-template-columns: auto 1fr; column-gap: 14px; }
    .st-cap h2 { font-size: 26px; }
    .st-cap p { grid-column: 2; margin-top: 4px; font-size: 16px; }
    .st-cap-n { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--brand); color: #fff; font-weight: 800; }
    .st-dots { display: none; }
    .st-build-stage { width: 100%; margin-top: 36px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-cap, .st-op, .st-contract, .st-build .sc-node, .st-build .sc-draw, .st-build .sc-pill, .st-wired { transition: none; }
  }
</style>
