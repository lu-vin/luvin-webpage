---
// Escena 5 de /product: el veredicto, en tipografía gigante. Las palabras aparecen una a una y, al
// lado, el paso que falló con su criterio y su campo marcados en rojo.
import { strings, type Lang } from '../../i18n/strings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const s = strings[lang].pages.story.verdict
const g = strings[lang].game
const [pre, bad, mid, good, post] = s.parts
const words = (text: string) => text.split(/(\s+)/).filter(Boolean)
let k = 0
---

<section class="st-verdict">
  <div class="container vd-inner">
    <p class="kicker reveal">{s.kicker}</p>
    <p class="vd-quote reveal">
      <span class="vd-step">getCustomer:</span>
      {words(pre).map((w) => (w.trim() ? <span class="vd-w" style={`--k:${k++}`}>{w}</span> : w))}
      <span class="vd-w vd-bad" style={`--k:${k++}`}>{bad}</span>
      {words(mid).map((w) => (w.trim() ? <span class="vd-w" style={`--k:${k++}`}>{w}</span> : w))}
      <span class="vd-w vd-good" style={`--k:${k++}`}>{good}</span>
      {words(post).map((w) => (w.trim() ? <span class="vd-w" style={`--k:${k++}`}>{w}</span> : w))}
    </p>
    <p class="st-sub vd-lead reveal">{s.lead}</p>
    <div class="vd-node reveal" aria-hidden="true">
      <header><span class="sc-n">2</span><b>getCustomer</b><span class="sc-m sc-get">GET</span></header>
      <div class="vd-sec">
        <h4>{g.criteria}</h4>
        <code>$statusCode == 200</code>
        <code class="vd-fail">$response.body#/status == 'ACTIVE'</code>
      </div>
      <div class="vd-sec">
        <h4>{g.outputs}</h4>
        <div class="vd-row"><code>id</code><code class="vd-ok">cus_7Q2K</code></div>
        <div class="vd-row"><code>status</code><code class="vd-red">INACTIVE</code></div>
      </div>
      <footer>200 OK · 96 ms</footer>
    </div>
  </div>
</section>

<style is:global>
  .st-verdict { padding: 150px 0 140px; background: radial-gradient(900px 500px at 50% 30%, rgba(229, 72, 77, .10), transparent 70%), #070c09; border-block: 1px solid var(--line); overflow: hidden; }
  .vd-inner { display: grid; justify-items: center; text-align: center; }
  .vd-quote { margin-top: 10px; max-width: 15ch; font: 800 clamp(44px, 7.6vw, 104px) / 1.02 'Inter Variable', Inter, sans-serif; letter-spacing: -.045em; }
  .vd-step { display: block; margin-bottom: 14px; font: 600 clamp(15px, 1.5vw, 19px) / 1 ui-monospace, 'SF Mono', Menlo, monospace; letter-spacing: 0; color: var(--muted); }
  .vd-w { display: inline-block; }
  .vd-bad { color: #ff8a8d; text-decoration: wavy underline rgba(255, 138, 141, .6); text-decoration-thickness: .05em; text-underline-offset: .14em; }
  .vd-good { color: var(--node); }
  .js .vd-quote:not(.in) .vd-w { opacity: 0; transform: translateY(.3em); filter: blur(6px); }
  .vd-quote.in .vd-w { transition: opacity .6s calc(var(--k) * .09s), transform .7s cubic-bezier(.2, .7, .2, 1) calc(var(--k) * .09s), filter .6s calc(var(--k) * .09s); }
  .vd-lead { max-width: 620px; }

  .vd-node { margin-top: 56px; width: min(100%, 380px); text-align: left; border-radius: 14px; overflow: hidden; background: linear-gradient(180deg, #132019, #0e1712); border: 1.5px solid #e5484d; box-shadow: 0 0 0 6px rgba(229, 72, 77, .1), 0 30px 80px rgba(0, 0, 0, .5); }
  .vd-node header { display: flex; align-items: center; gap: 8px; padding: 14px 16px; }
  .vd-node header b { font-size: 16px; }
  .vd-node .sc-n { width: 22px; height: 22px; font-size: 12px; }
  .vd-node .sc-m { margin-left: auto; font-size: 11.5px; padding: 2px 7px; border-radius: 6px; }
  .vd-sec { display: grid; gap: 6px; padding: 10px 16px 12px; border-top: 1px solid #223028; }
  .vd-sec h4 { margin: 0; font-size: 10.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .vd-sec code { font: 500 13px/1.4 ui-monospace, 'SF Mono', Menlo, monospace; color: var(--muted); }
  .vd-row { display: flex; justify-content: space-between; }
  .vd-ok { color: var(--node) !important; }
  .vd-red, .vd-fail { color: #ff8a8d !important; }
  .vd-fail { text-decoration: wavy underline rgba(255, 138, 141, .6); text-underline-offset: 3px; }
  .vd-node footer { padding: 10px 16px; border-top: 1px solid #223028; font: 700 12.5px/1 ui-monospace, 'SF Mono', Menlo, monospace; color: #ff8a8d; }
  @media (max-width: 600px) {
    .st-verdict { padding: 96px 0 88px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .vd-quote:not(.in) .vd-w { opacity: 1; transform: none; filter: none; }
  }
</style>
