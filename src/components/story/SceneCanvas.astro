---
// Un lienzo de workflow como el de la app: pasos en HTML y líneas de datos en SVG, en unidades de
// diseño (src/lib/scene.ts) para que escale como una imagen. Lo usan las escenas de /product.
import { layout, VALUES, type Variant } from '../../lib/scene'
import { strings, type Lang } from '../../i18n/strings'

interface Props {
  lang: Lang
  id: string
  variant: Variant
  label: string
  status?: boolean // reserva la fila del resultado de cada paso (escena "Ejecútala")
  packets?: boolean // valores que viajan por las líneas, en bucle
  values?: boolean // los outputs muestran sus valores desde el principio
  class?: string
}
const { lang, id, variant, label, status = false, packets = false, values = false } = Astro.props
const g = strings[lang].game
const L = layout(variant, status)
const u = (n: number) => `calc(var(--u) * ${n})`
const short = (from: string) => (from.startsWith('inputs.') ? from : from.split('.')[1])
const pillW = (s: string) => s.length * 7.4 + 18
---

<div
  class:list={['sc', `sc-${variant}`, Astro.props.class, { 'sc-values': values }]}
  style={`--W:${L.W}; aspect-ratio:${L.W} / ${L.H}`}
  role="img"
  aria-label={label}
  data-scene={id}>
  {
    packets && (
      <svg class="sc-packets" viewBox={`0 0 ${L.W} ${L.H}`} aria-hidden="true">
        {L.wires.map((w, k) => (
          <g class="sc-packet">
            <rect x={-pillW(VALUES[w.from]) / 2} y="-11" width={pillW(VALUES[w.from])} height="22" rx="11" />
            <text y="4">{VALUES[w.from]}</text>
            <animateMotion
              dur="3.6s"
              begin={`${2 + k * 0.45}s`}
              repeatCount="indefinite"
              path={w.pd}
              calcMode="spline"
              keyTimes="0;0.6;1"
              keyPoints="0;1;1"
              keySplines="0.45 0 0.2 1;0 0 1 1"
            />
            <animate attributeName="opacity" dur="3.6s" begin={`${2 + k * 0.45}s`} repeatCount="indefinite" values="0;1;1;0;0" keyTimes="0;0.06;0.6;0.61;1" />
          </g>
        ))}
      </svg>
    )
  }
  <svg class="sc-wires" viewBox={`0 0 ${L.W} ${L.H}`} aria-hidden="true">
    <defs>
      {
        L.wires.map((w, k) => (
          <mask id={`${id}-m${k}`} maskUnits="userSpaceOnUse" x="0" y="0" width={L.W} height={L.H}>
            <path class="sc-draw" style={`--k:${k}`} d={w.d} pathLength="1" />
          </mask>
        ))
      }
    </defs>
    {
      L.wires.map((w, k) => (
        <g class="sc-wire" data-from={w.from.split('.')[0]} data-to={w.to.split('.')[0]} data-wire={`${w.from}>${w.to}`} style={`--k:${k}`}>
          <path class="sc-line" d={w.d} mask={`url(#${id}-m${k})`} />
          <path class="sc-lit" d={w.d} pathLength="1" />
        </g>
      ))
    }
  </svg>
  {
    L.boxes.map((b) => (
      <article class="sc-node" data-step={b.id} style={`--i:${b.index}; left:${u(b.x)}; top:${u(b.y)}; width:${u(b.w)}; height:${u(b.h)}`} aria-hidden="true">
        <header class="sc-head">
          <span class="sc-n">{b.index + 1}</span>
          <b>{b.id}</b>
          <span class={`sc-m sc-${b.step.method.toLowerCase()}`}>{b.step.method}</span>
          <code class="sc-path">{b.step.path}</code>
        </header>
        <div class="sc-sec">
          <h4>{g.params}</h4>
          {b.step.params.map((p) => (
            <div class={`sc-row sc-param${variant === 'tall' ? ' sc-right' : ''}`} data-row={`${b.id}.${p.name}`}>
              <span>{p.name}</span>
              {p.from && (
                <span class={`sc-pill${p.from.startsWith('inputs.') ? ' sc-input' : ''}`} data-param={`${b.id}.${p.name}`}>
                  {short(p.from)}
                </span>
              )}
            </div>
          ))}
        </div>
        <div class="sc-sec">
          <h4>{g.outputs}</h4>
          {b.step.outputs.map((o) => (
            <div class="sc-row sc-out" data-row={`${b.id}.${o}`}>
              <span>{o}</span>
              <span class="sc-val">{VALUES[`${b.id}.${o}`] ?? ''}</span>
            </div>
          ))}
        </div>
        {status && <div class="sc-status" />}
      </article>
    ))
  }
  <slot />
</div>

<style is:global>
  /* Cada escena trae dos lienzos: en fila (pantallas anchas) y en columna (teléfono). */
  .st-only-tall { display: none; }
  @media (max-width: 860px) {
    .st-only-wide { display: none; }
    .st-only-tall { display: block; }
  }
  @keyframes st-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .sc {
    --flow: #b58cff;
    --node-bg: #0e1712;
    position: relative; width: 100%; container-type: inline-size;
    font-family: 'Inter Variable', Inter, system-ui, sans-serif;
  }
  .sc > *, .sc > * * { --u: calc(100cqw / var(--W)); }
  .sc-wires, .sc-packets { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; z-index: 2; pointer-events: none; }
  .sc-packets { z-index: 0; }
  .sc-draw { fill: none; stroke: #fff; stroke-width: 6; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .sc-line { fill: none; stroke: var(--flow); stroke-width: 2; stroke-dasharray: 5 4; opacity: .85; }
  .sc-lit { fill: none; stroke: #e9dcff; stroke-width: 3; stroke-linecap: round; stroke-dasharray: 0 1; opacity: 0; filter: drop-shadow(0 0 6px var(--flow)); }
  .sc-wire.lit .sc-lit { opacity: 1; animation: sc-lit .75s cubic-bezier(.45, 0, .2, 1) both; }
  @keyframes sc-lit { from { stroke-dasharray: .16 1; stroke-dashoffset: .16; } to { stroke-dasharray: .16 1; stroke-dashoffset: -1; } }
  .sc-packet rect { fill: #1b1330; stroke: var(--flow); stroke-width: 1.2; }
  .sc-packet text { fill: #e9dcff; font: 600 12px ui-monospace, 'SF Mono', Menlo, monospace; text-anchor: middle; }
  .sc-packet { opacity: 0; filter: drop-shadow(0 0 10px rgba(181, 140, 255, .55)); }

  .sc-node {
    position: absolute; z-index: 1; display: flex; flex-direction: column; overflow: hidden;
    border-radius: calc(var(--u) * 14); background: linear-gradient(180deg, #132019, var(--node-bg));
    border: calc(var(--u) * 1.5) solid #2f4237;
    box-shadow: 0 calc(var(--u) * 24) calc(var(--u) * 60) rgba(0, 0, 0, .45), inset 0 1px 0 rgba(255, 255, 255, .05);
    color: var(--ink); font-size: calc(var(--u) * 13); text-align: left;
    transition: border-color .3s, box-shadow .3s;
  }
  .sc-head { display: grid; grid-template-columns: auto 1fr auto; align-items: center; column-gap: calc(var(--u) * 8); height: calc(var(--u) * 70); padding: 0 calc(var(--u) * 14); align-content: center; row-gap: calc(var(--u) * 4); }
  .sc-head b { font-size: calc(var(--u) * 15.5); font-weight: 700; letter-spacing: -.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sc-n { display: grid; place-items: center; width: calc(var(--u) * 22); height: calc(var(--u) * 22); border-radius: 50%; background: var(--brand); color: #fff; font-size: calc(var(--u) * 12); font-weight: 800; }
  .sc-m { padding: calc(var(--u) * 2) calc(var(--u) * 7); border-radius: calc(var(--u) * 6); color: #fff; font: 700 calc(var(--u) * 11.5) / 1.3 ui-monospace, 'SF Mono', Menlo, monospace; }
  .sc-get { background: #3b82f6; }
  .sc-post { background: #d97706; }
  .sc-path { grid-column: 1 / -1; color: var(--muted); font: 500 calc(var(--u) * 12.5) / 1.2 ui-monospace, 'SF Mono', Menlo, monospace; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sc-sec { border-top: 1px solid #223028; padding: 0 calc(var(--u) * 14) calc(var(--u) * 8); }
  .sc-sec h4 { height: calc(var(--u) * 26); margin: 0; display: flex; align-items: flex-end; font-size: calc(var(--u) * 10.5); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); padding-bottom: calc(var(--u) * 3); }
  .sc-row { position: relative; display: flex; align-items: center; justify-content: space-between; gap: calc(var(--u) * 8); height: calc(var(--u) * 36); font: 500 calc(var(--u) * 13) / 1 ui-monospace, 'SF Mono', Menlo, monospace; }
  .sc-row > span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sc-param::before, .sc-out::after { content: ''; position: absolute; top: 50%; width: calc(var(--u) * 8); height: calc(var(--u) * 8); margin-top: calc(var(--u) * -4); border-radius: calc(var(--u) * 2); background: var(--flow); }
  .sc-param::before { left: calc(var(--u) * -18.5); }
  .sc-param.sc-right::before { left: auto; right: calc(var(--u) * -18.5); }
  .sc-out::after { right: calc(var(--u) * -18.5); }
  .sc-node[data-step='signIn'] .sc-param::before { background: #2f4237; }
  .sc-pill { padding: calc(var(--u) * 4) calc(var(--u) * 8); border-radius: calc(var(--u) * 7); color: var(--flow); background: rgba(181, 140, 255, .1); border: 1px solid rgba(181, 140, 255, .35); font-weight: 600; font-size: calc(var(--u) * 12); white-space: nowrap; transition: opacity .5s, transform .5s; }
  .sc-val { color: var(--node); font-size: calc(var(--u) * 12); white-space: nowrap; opacity: 0; transform: translateX(calc(var(--u) * 6)); transition: opacity .4s, transform .4s; }
  .sc-values .sc-val, .sc-node.sc-ok .sc-val { opacity: 1; transform: none; }
  .sc-status { margin-top: auto; height: calc(var(--u) * 36); display: flex; align-items: center; padding: 0 calc(var(--u) * 14); border-top: 1px solid #223028; font: 700 calc(var(--u) * 12.5) / 1 ui-monospace, 'SF Mono', Menlo, monospace; color: var(--node); opacity: 0; transition: opacity .3s; }
  .sc-node.sc-ok .sc-status { opacity: 1; }
  .sc-node.sc-on { border-color: var(--flow); box-shadow: 0 0 0 calc(var(--u) * 5) rgba(181, 140, 255, .16), 0 calc(var(--u) * 24) calc(var(--u) * 60) rgba(0, 0, 0, .45); }
  .sc-node.sc-ok { border-color: var(--brand); box-shadow: 0 0 calc(var(--u) * 40) rgba(47, 143, 63, .25), 0 calc(var(--u) * 24) calc(var(--u) * 60) rgba(0, 0, 0, .45); }
  @media (prefers-reduced-motion: reduce) {
    .sc-packet { display: none; }
    .sc-wire.lit .sc-lit { opacity: 1; animation: none; }
  }
</style>
