---
import { strings, type Lang } from '../../i18n/strings'

interface Props {
  lang: Lang
  /** Es la página principal: el título va como h1 y la sección arranca bajo la cabecera. */
  page?: boolean
}
const { lang, page = false } = Astro.props
const Heading = page ? 'h1' : 'h2'
const t = strings[lang]
---

<!-- Preguntas -->
<section id="faq" class={`section alt${page ? ' page-top' : ''}`}>
  <div class="container faq">
    <div class="faq-head reveal">
      <p class="kicker">{t.faq.kicker}</p>
      <Heading>{t.faq.title}</Heading>
    </div>
    <div class="faq-list reveal">
      {
        t.faq.items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
