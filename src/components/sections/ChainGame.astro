---
// El juego de la portada: conectar, ejecutar y romper un workflow de tres llamadas, como en la app.
// Todo es simulado en el navegador (no llama a ninguna API) y solo muestra lo que la app ya hace:
// conexión de datos por reglas, ejecución paso a paso, casos generados, veredictos y el Arazzo.
import { strings, type Lang } from '../../i18n/strings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = strings[lang]
const g = t.game

// Los pasos son nombres técnicos, iguales en los dos idiomas (como en un contrato).
const steps = [
  {
    id: 'signIn',
    method: 'POST',
    path: '/login',
    params: [{ name: 'email', fixed: 'inputs.email' }],
    criteria: ['$statusCode == 200'],
    outputs: ['token', 'customerId', 'expiresIn'],
  },
  {
    id: 'getCustomer',
    method: 'GET',
    path: '/customers/{customerId}',
    params: [
      { name: 'Authorization', need: 'token' },
      { name: 'customerId', need: 'customerId' },
    ],
    criteria: ['$statusCode == 200', "$response.body#/status == 'ACTIVE'"],
    outputs: ['status', 'name'],
  },
  {
    id: 'openAccount',
    method: 'POST',
    path: '/accounts',
    params: [
      { name: 'Authorization', need: 'token' },
      { name: 'customerId', need: 'customerId' },
    ],
    criteria: ['$statusCode == 201'],
    outputs: ['accountId'],
  },
]
---

<!-- Pruébalo: el juego -->
<section id="play" class="section play">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{g.kicker}</p>
      <h2>{g.title}</h2>
      <p class="body">{g.lead}</p>
    </div>

    <div class="cg reveal" data-t={JSON.stringify(g)} data-steps={JSON.stringify(steps)}>
      <div class="cg-bar">
        <ol class="cg-levels">
          {
            g.levels.map((l, i) => (
              <li>
                <button type="button" class="cg-level" data-level={i} disabled={i > 0}>
                  <span class="cg-level-n">{i + 1}</span>
                  {l}
                </button>
              </li>
            ))
          }
        </ol>
        <span class="cg-sim"><span class="cg-dot" aria-hidden="true"></span>{g.sim}</span>
      </div>

      <div class="cg-tools">
        <div class="cg-tool" data-for="0">
          <p class="cg-hint">{g.wire.hint}</p>
          <div class="cg-actions">
            <button type="button" class="cg-btn cg-auto">{g.wire.auto}</button>
            <button type="button" class="cg-btn cg-ghost cg-reset">{g.wire.reset}</button>
          </div>
        </div>
        <div class="cg-tool" data-for="1" hidden>
          <p class="cg-hint">{g.run.hint}</p>
          <form class="cg-actions cg-run-form">
            <label class="cg-input">
              <span>{g.run.inputs} · email</span>
              <input type="text" name="email" value="ada@example.com" autocomplete="off" spellcheck="false" />
            </label>
            <button type="submit" class="cg-btn cg-run">▶ {g.run.button}</button>
          </form>
        </div>
        <div class="cg-tool" data-for="2" hidden>
          <p class="cg-hint">{g.cases.hint}</p>
          <div class="cg-actions">
            <button type="button" class="cg-btn cg-run-cases">▶ {g.cases.button}</button>
          </div>
        </div>
        <div class="cg-tool" data-for="3" hidden>
          <p class="cg-hint">{g.arazzo.body}</p>
          <div class="cg-actions">
            <button type="button" class="cg-btn cg-ghost cg-copy">{g.arazzo.copy}</button>
            <button type="button" class="cg-btn cg-ghost cg-again">{g.arazzo.again}</button>
          </div>
        </div>
      </div>

      <div class="cg-canvas">
        <svg class="cg-wires" aria-hidden="true"></svg>
        {
          steps.map((s, i) => (
            <article class="cg-node" data-step={s.id}>
              <header class="cg-head">
                <span class="cg-n">{i + 1}</span>
                <b>{s.id}</b>
                <span class={`cg-m cg-${s.method.toLowerCase()}`}>{s.method}</span>
              </header>
              <code class="cg-path">{s.path}</code>
              <div class="cg-sec">
                <h4>{g.params}</h4>
                {s.params.map((p) => (
                  <div class="cg-row cg-param">
                    <span class="cg-pname">{p.name}</span>
                    {'fixed' in p ? (
                      <span class="cg-pill">{p.fixed}</span>
                    ) : (
                      <button type="button" class="cg-slot" data-slot={`${s.id}.${p.name}`} data-need={p.need}>
                        {g.slot}
                      </button>
                    )}
                  </div>
                ))}
              </div>
              <div class="cg-sec">
                <h4>{g.criteria}</h4>
                {s.criteria.map((c, k) => (
                  <code class="cg-crit" data-crit={k}>
                    {c}
                  </code>
                ))}
              </div>
              <div class="cg-sec">
                <h4>{g.outputs}</h4>
                {s.outputs.map((o) => (
                  <div class="cg-row cg-outrow">
                    <button type="button" class="cg-out" data-out={`${s.id}.${o}`}>
                      <span>{o}</span>
                      <span class="cg-val" />
                    </button>
                  </div>
                ))}
              </div>
              <div class="cg-status" />
            </article>
          ))
        }
      </div>

      <ol class="cg-cases" hidden>
        {
          g.cases.items.map((c) => (
            <li class="cg-case" data-case={c.id}>
              <span class="cg-case-icon" aria-hidden="true">•</span>
              <div>
                <b>{c.name}</b>
                <span class="cg-tag">{c.id === 'inactive' ? g.cases.yours : g.cases.generated}</span>
                <p class="cg-case-expect">{c.expect}</p>
                <p class="cg-case-result" />
              </div>
            </li>
          ))
        }
      </ol>

      <div class="cg-yaml" hidden>
        <pre><code /></pre>
      </div>

      <div class="cg-result" aria-live="polite">
        <p class="cg-msg"></p>
        <button type="button" class="cg-btn cg-next" hidden></button>
      </div>
      <noscript><p class="cg-hint">{g.noscript}</p></noscript>
    </div>
    <p class="cg-note">{g.demoNote}</p>
  </div>
</section>

<script>
  type Step = { id: string; method: string; path: string; params: { name: string; need?: string; fixed?: string }[]; criteria: string[]; outputs: string[] }
  type Kind = 'info' | 'ok' | 'err'

  const root = document.querySelector<HTMLElement>('.cg')
  if (root) game(root)

  function game(root: HTMLElement) {
    const T = JSON.parse(root.dataset.t!)
    const STEPS: Step[] = JSON.parse(root.dataset.steps!)
    const order = STEPS.map((s) => s.id)
    const $ = <E extends Element = HTMLElement>(sel: string) => root.querySelector<E>(sel)!
    const $$ = <E extends Element = HTMLElement>(sel: string) => [...root.querySelectorAll<E>(sel)]
    const canvas = $('.cg-canvas')
    const svg = $<SVGSVGElement>('.cg-wires')
    const msg = $('.cg-msg')
    const next = $<HTMLButtonElement>('.cg-next')
    const slots = $$<HTMLButtonElement>('.cg-slot')
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
    const NS = 'http://www.w3.org/2000/svg'
    const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''))
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, reduced ? Math.min(ms, 120) : ms))

    // Estado: qué output alimenta cada parámetro, el nivel abierto y hasta dónde se llegó.
    const wires = new Map<string, string>()
    let level = 0
    let unlocked = 0
    let picked: HTMLButtonElement | null = null
    let started = 0
    let busy = false
    let cut = '' // un parámetro sin valor durante un caso (sin credenciales)

    // ---------- Mensajes y niveles ----------
    function say(text: string, kind: Kind = 'info', nextLabel?: string, onNext?: () => void) {
      msg.textContent = text
      msg.dataset.kind = kind
      next.hidden = !nextLabel
      if (nextLabel) {
        next.textContent = nextLabel + ' →'
        next.onclick = () => onNext?.()
      }
    }
    function unlock(n: number, force = false) {
      unlocked = force ? n : Math.max(unlocked, n)
      $$<HTMLButtonElement>('.cg-level').forEach((b) => (b.disabled = Number(b.dataset.level) > unlocked))
    }
    function go(n: number) {
      level = n
      root.dataset.level = String(n)
      $$<HTMLButtonElement>('.cg-level').forEach((b) => b.setAttribute('aria-current', String(Number(b.dataset.level) === n)))
      $$('.cg-tool').forEach((el) => (el.hidden = Number(el.dataset.for) !== n))
      $('.cg-cases').hidden = n !== 2
      $('.cg-yaml').hidden = n !== 3
      canvas.hidden = n === 3
      clearRun()
      if (n === 0) say(T.wire.hint, 'info', wires.size === slots.length ? T.wire.next : undefined, () => go(1))
      if (n === 1) say(T.run.hint)
      if (n === 2) say(T.cases.hint)
      if (n === 3) {
        renderYaml()
        say(T.arazzo.title, 'ok', T.arazzo.cta, () => document.getElementById('waitlist')?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth' }))
      }
      draw()
    }
    $$<HTMLButtonElement>('.cg-level').forEach((b) => b.addEventListener('click', () => !busy && go(Number(b.dataset.level))))

    // ---------- Conectar ----------
    const stepOf = (id: string) => id.split('.')[0]
    const nameOf = (id: string) => id.split('.')[1]
    function connect(outId: string, slot: HTMLButtonElement) {
      const slotId = slot.dataset.slot!
      const src = nameOf(outId)
      const param = nameOf(slotId)
      setPicked(null)
      if (order.indexOf(stepOf(outId)) >= order.indexOf(stepOf(slotId))) return reject(slot, fill(T.wire.later, { src }))
      if (src !== slot.dataset.need) return reject(slot, fill(T.wire.wrong, { param, need: T.desc[slot.dataset.need!], src, desc: T.desc[src] }))
      wires.set(slotId, outId)
      draw()
      const left = slots.length - wires.size
      if (left > 0) return say(fill(T.wire.ok, { src, step: stepOf(slotId), param, n: left }), 'ok')
      unlock(1)
      say(fill(T.wire.done, { s: Math.max(1, Math.round((performance.now() - started) / 1000)) }), 'ok', T.wire.next, () => go(1))
    }
    function reject(slot: HTMLElement, text: string) {
      say(text, 'err')
      slot.classList.remove('cg-shake')
      void slot.offsetWidth
      slot.classList.add('cg-shake')
      slot.addEventListener('animationend', () => slot.classList.remove('cg-shake'), { once: true })
    }
    function setPicked(b: HTMLButtonElement | null) {
      picked?.classList.remove('cg-picked')
      picked = b
      picked?.classList.add('cg-picked')
      root.classList.toggle('cg-picking', !!b)
    }

    // Arrastrar un output, o tocarlo y después tocar el parámetro (también con el teclado).
    let drag: { out: HTMLButtonElement; x: number; y: number; moved: boolean } | null = null
    let droppedAt = 0
    let droppedOut: HTMLButtonElement | null = null
    $$<HTMLButtonElement>('.cg-out').forEach((out) => {
      out.addEventListener('pointerdown', (e) => {
        if (level !== 0 || busy) return
        if (!started) started = performance.now()
        drag = { out, x: e.clientX, y: e.clientY, moved: false }
      })
      out.addEventListener('click', () => {
        if (out === droppedOut && performance.now() - droppedAt < 400) return // el click que sigue a su arrastre
        if (level !== 0 || busy) return
        if (!started) started = performance.now()
        if (picked === out) return setPicked(null)
        setPicked(out)
        say(fill(T.wire.picked, { src: nameOf(out.dataset.out!) }))
      })
    })
    // El movimiento y el soltar se escuchan en toda la ventana: el puntero termina sobre otro elemento.
    addEventListener('pointermove', (e) => {
      if (!drag) return
      if (!drag.moved && Math.hypot(e.clientX - drag.x, e.clientY - drag.y) < 6) return
      drag.moved = true
      e.preventDefault()
      setPicked(drag.out)
      draw({ from: drag.out.dataset.out!, x: e.clientX, y: e.clientY })
    })
    addEventListener('pointerup', (e) => {
      if (!drag) return
      const d = drag
      drag = null
      if (!d.moved) return
      droppedAt = performance.now()
      droppedOut = d.out
      const slot = document.elementFromPoint(e.clientX, e.clientY)?.closest<HTMLButtonElement>('.cg-slot')
      if (slot && root.contains(slot)) connect(d.out.dataset.out!, slot)
      else {
        setPicked(null)
        draw()
      }
    })
    addEventListener('pointercancel', () => {
      if (!drag) return
      drag = null
      setPicked(null)
      draw()
    })
    slots.forEach((slot) =>
      slot.addEventListener('click', () => {
        if (level !== 0 || busy) return
        if (picked) return connect(picked.dataset.out!, slot)
        if (wires.delete(slot.dataset.slot!)) {
          // Tocar un parámetro conectado lo desconecta, para corregir; los niveles siguientes esperan.
          unlock(0, true)
          draw()
          say(T.wire.hint)
        }
      }),
    )

    $('.cg-auto').addEventListener('click', async () => {
      if (busy) return
      busy = true
      setPicked(null)
      for (const slot of slots) {
        if (wires.has(slot.dataset.slot!)) continue
        wires.set(slot.dataset.slot!, `signIn.${slot.dataset.need}`)
        draw()
        await sleep(220)
      }
      busy = false
      unlock(1)
      say(T.wire.doneAuto, 'ok', T.wire.next, () => go(1))
    })
    $('.cg-reset').addEventListener('click', () => {
      if (busy) return
      wires.clear()
      started = 0
      unlock(0, true)
      setPicked(null)
      go(0)
    })

    // ---------- Dibujar las conexiones ----------
    function anchor(el: Element, side: 'left' | 'right') {
      const c = canvas.getBoundingClientRect()
      const node = el.closest('.cg-node')!.getBoundingClientRect()
      const r = el.getBoundingClientRect()
      return { x: (side === 'right' ? node.right : node.left) - c.left, y: r.top + r.height / 2 - c.top }
    }
    function pathFor(outId: string, slotId: string, lane: number) {
      const out = $(`.cg-out[data-out="${outId}"]`)
      const slot = $(`.cg-slot[data-slot="${slotId}"]`)
      const stacked = root.classList.contains('cg-stacked')
      const a = anchor(out, 'right')
      const b = anchor(slot, stacked ? 'right' : 'left')
      if (stacked) {
        // Una debajo de la otra: la línea sale por la derecha y vuelve a entrar por la derecha.
        const x = a.x + 14 + lane * 9
        return `M${a.x} ${a.y} H${x - 6} Q${x} ${a.y} ${x} ${a.y + 6} V${b.y - 6} Q${x} ${b.y} ${x - 6} ${b.y} H${b.x}`
      }
      const skip = order.indexOf(stepOf(slotId)) - order.indexOf(stepOf(outId)) > 1
      if (!skip) {
        const m = (a.x + b.x) / 2
        return `M${a.x} ${a.y} C${m} ${a.y} ${m} ${b.y} ${b.x} ${b.y}`
      }
      // Salta un paso: pasa por debajo de los nodos, sin cruzarlos.
      const nodes = $$('.cg-node').map((n) => n.getBoundingClientRect())
      const c = canvas.getBoundingClientRect()
      const y = Math.max(...nodes.map((n) => n.bottom)) - c.top + 16 + lane * 10
      const x1 = (nodes[0].right + nodes[1].left) / 2 - c.left - lane * 6
      const x2 = (nodes[1].right + nodes[2].left) / 2 - c.left + lane * 6
      const r = 8
      return `M${a.x} ${a.y} H${x1 - r} Q${x1} ${a.y} ${x1} ${a.y + r} V${y - r} Q${x1} ${y} ${x1 + r} ${y} H${x2 - r} Q${x2} ${y} ${x2} ${y - r} V${b.y + r} Q${x2} ${b.y} ${x2 + r} ${b.y} H${b.x}`
    }
    function draw(temp?: { from: string; x: number; y: number }) {
      const nodes = $$('.cg-node')
      root.classList.toggle('cg-stacked', nodes[1].getBoundingClientRect().top > nodes[0].getBoundingClientRect().bottom - 1)
      const c = canvas.getBoundingClientRect()
      svg.setAttribute('viewBox', `0 0 ${c.width} ${c.height}`)
      svg.replaceChildren()
      let lane = 0
      for (const slot of slots) {
        const id = slot.dataset.slot!
        const outId = wires.get(id)
        slot.classList.toggle('cg-wired', !!outId)
        slot.classList.toggle('cg-cut', cut === id)
        slot.textContent = outId ? nameOf(outId) : T.slot
        if (!outId) continue
        const p = document.createElementNS(NS, 'path')
        p.setAttribute('d', pathFor(outId, id, lane++))
        p.dataset.wire = id
        if (cut === id) p.classList.add('cg-cut')
        svg.append(p)
      }
      $$<HTMLButtonElement>('.cg-out').forEach((o) => o.classList.toggle('cg-used', [...wires.values()].includes(o.dataset.out!)))
      if (temp) {
        const a = anchor($(`.cg-out[data-out="${temp.from}"]`), 'right')
        const x = temp.x - c.left
        const y = temp.y - c.top
        const p = document.createElementNS(NS, 'path')
        p.setAttribute('d', `M${a.x} ${a.y} C${(a.x + x) / 2} ${a.y} ${(a.x + x) / 2} ${y} ${x} ${y}`)
        p.classList.add('cg-temp')
        svg.append(p)
      }
    }
    new ResizeObserver(() => draw()).observe(canvas)

    // ---------- Ejecutar (simulado) ----------
    const hash = (s: string, n: number) => {
      let h = 2166136261
      for (const ch of s) h = Math.imul(h ^ ch.charCodeAt(0), 16777619)
      let out = ''
      const abc = '0123456789ABCDEFGHJKMNPQRSTVWXYZ'
      for (let i = 0; i < n; i++) out += abc[(h >>> (i * 5)) & 31]
      return out
    }
    function clearRun() {
      cut = ''
      $$('.cg-node').forEach((n) => {
        n.classList.remove('cg-running', 'cg-ok', 'cg-fail', 'cg-expected')
        n.querySelector('.cg-status')!.textContent = ''
      })
      $$('.cg-val').forEach((v) => {
        v.textContent = ''
        v.classList.remove('cg-bad')
      })
      $$('.cg-crit').forEach((c) => c.classList.remove('cg-bad'))
    }
    function node(id: string) {
      return $(`.cg-node[data-step="${id}"]`)
    }
    function setVal(step: string, out: string, v: string, bad = false) {
      const el = $(`.cg-out[data-out="${step}.${out}"] .cg-val`)
      el.textContent = v
      el.classList.toggle('cg-bad', bad)
    }
    async function call(step: string, status: string, ms: number, state: 'ok' | 'fail' | 'expected') {
      const n = node(step)
      n.classList.add('cg-running')
      await sleep(420)
      n.classList.remove('cg-running')
      n.classList.add(`cg-${state}`)
      n.querySelector('.cg-status')!.textContent = `${status} · ${ms} ms`
    }
    // Un punto con el valor viaja por cada conexión que sale del paso.
    async function flow(fromStep: string, toStep: string) {
      const paths = [...svg.querySelectorAll<SVGPathElement>('path[data-wire]')].filter(
        (p) => stepOf(p.dataset.wire!) === toStep && stepOf(wires.get(p.dataset.wire!)!) === fromStep && !p.classList.contains('cg-cut'),
      )
      if (!paths.length || reduced) return sleep(150)
      const dots = paths.map(() => {
        const d = document.createElementNS(NS, 'circle')
        d.setAttribute('r', '5')
        d.classList.add('cg-packet')
        svg.append(d)
        return d
      })
      const dur = 650
      const t0 = performance.now()
      await new Promise<void>((done) => {
        const tick = (now: number) => {
          const k = Math.min(1, (now - t0) / dur)
          const e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2
          paths.forEach((p, i) => {
            const pt = p.getPointAtLength(p.getTotalLength() * e)
            dots[i].setAttribute('cx', String(pt.x))
            dots[i].setAttribute('cy', String(pt.y))
          })
          if (k < 1) requestAnimationFrame(tick)
          else done()
        }
        requestAnimationFrame(tick)
      })
      dots.forEach((d) => d.remove())
    }

    // Ejecuta el workflow con un email; devuelve cómo terminó.
    type End = { at: 'signIn' | 'getCustomer' | 'openAccount'; code: number; why?: 'empty' | 'invalid' | 'inactive' | 'noauth'; id?: string }
    async function runChain(email: string, noAuth = false): Promise<End> {
      clearRun()
      if (noAuth) cut = 'getCustomer.Authorization'
      draw()
      if (noAuth) await sleep(350)
      const ms = (k: string) => 90 + (parseInt(hash(email + k, 2), 32) % 140)
      if (!email.trim()) {
        await call('signIn', '400 Bad Request', ms('a'), 'fail')
        return { at: 'signIn', code: 400, why: 'empty' }
      }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email.trim())) {
        await call('signIn', '400 Bad Request', ms('a'), 'fail')
        return { at: 'signIn', code: 400, why: 'invalid' }
      }
      await call('signIn', '200 OK', ms('a'), 'ok')
      setVal('signIn', 'token', `eyJhb…${hash(email + 't', 4).toLowerCase()}`)
      setVal('signIn', 'customerId', `cus_${hash(email, 4)}`)
      setVal('signIn', 'expiresIn', '3600')
      await flow('signIn', 'getCustomer')
      if (cut === 'getCustomer.Authorization') {
        await call('getCustomer', '401 Unauthorized', ms('b'), 'fail')
        return { at: 'getCustomer', code: 401, why: 'noauth' }
      }
      const inactive = email.trim().toLowerCase().startsWith('inactive')
      await call('getCustomer', '200 OK', ms('b'), inactive ? 'fail' : 'ok')
      const who = email.split('@')[0].replace(/[^a-z]/gi, ' ').trim()
      setVal('getCustomer', 'status', inactive ? 'INACTIVE' : 'ACTIVE', inactive)
      setVal('getCustomer', 'name', inactive || !who ? 'Grace' : who[0].toUpperCase() + who.slice(1))
      if (inactive) {
        $('.cg-node[data-step="getCustomer"] .cg-crit[data-crit="1"]').classList.add('cg-bad')
        return { at: 'getCustomer', code: 200, why: 'inactive' }
      }
      await flow('signIn', 'openAccount')
      await call('openAccount', '201 Created', ms('c'), 'ok')
      const id = `acc_${hash(email + 'acc', 5)}`
      setVal('openAccount', 'accountId', id)
      return { at: 'openAccount', code: 201, id }
    }

    $<HTMLFormElement>('.cg-run-form').addEventListener('submit', async (e) => {
      e.preventDefault()
      if (busy) return
      busy = true
      const email = $<HTMLInputElement>('.cg-run-form input').value
      say('…')
      const end = await runChain(email)
      busy = false
      if (end.id) {
        unlock(2)
        say(fill(T.run.passed, { id: end.id }), 'ok', T.run.next, () => go(2))
      } else say(T.run[end.why!], 'err', unlocked >= 2 ? T.run.next : undefined, () => go(2))
    })

    // ---------- Romper: los casos ----------
    $('.cg-run-cases').addEventListener('click', async () => {
      if (busy) return
      busy = true
      say('…')
      const items = $$('.cg-case')
      items.forEach((li) => {
        li.dataset.state = ''
        li.querySelector('.cg-case-result')!.textContent = ''
      })
      for (const li of items) {
        const id = li.dataset.case!
        li.dataset.state = 'running'
        const result = li.querySelector('.cg-case-result')!
        let pass = false
        if (id === 'happy') pass = !!(await runChain('ada@example.com')).id
        if (id === 'missing') {
          const end = await runChain('')
          pass = end.code === 400
          if (pass) node('signIn').classList.replace('cg-fail', 'cg-expected')
        }
        if (id === 'noauth') {
          const end = await runChain('ada@example.com', true)
          pass = end.code === 401
          if (pass) node('getCustomer').classList.replace('cg-fail', 'cg-expected')
        }
        if (id === 'inactive') pass = !!(await runChain('inactive@example.com')).id
        li.dataset.state = pass ? 'pass' : 'fail'
        result.textContent = pass ? T.cases.pass[id] : T.run.inactive
        await sleep(pass ? 650 : 200)
      }
      busy = false
      unlock(3)
      say(T.cases.summary, 'err', T.cases.next, () => go(3))
    })
    // ---------- El Arazzo ----------
    let yamlText = ''
    function renderYaml() {
      const ref = (slotId: string) => `$steps.${wires.get(slotId)!.replace('.', '.outputs.')}`
      const lines: [string, boolean?][] = [
        ['arazzo: 1.0.1'],
        ['info:'],
        ['  title: Open an account'],
        ['  version: 1.0.0'],
        ['sourceDescriptions:'],
        ['  - name: bank'],
        ['    url: ./bank.openapi.yaml'],
        ['    type: openapi'],
        ['workflows:'],
        ['  - workflowId: openAccount'],
        ['    inputs:'],
        ['      type: object'],
        ['      properties:'],
        ['        email:'],
        ['          type: string'],
        ['    steps:'],
        ['      - stepId: signIn'],
        ['        operationId: signIn'],
        ['        requestBody:'],
        ['          payload:'],
        ['            email: $inputs.email', true],
        ['        successCriteria:'],
        ['          - condition: $statusCode == 200'],
        ['        outputs:'],
        ['          token: $response.body#/token'],
        ['          customerId: $response.body#/customerId'],
        ['      - stepId: getCustomer'],
        ['        operationId: getCustomer'],
        ['        parameters:'],
        ['          - name: Authorization'],
        ['            in: header'],
        [`            value: Bearer {${ref('getCustomer.Authorization')}}`, true],
        ['          - name: customerId'],
        ['            in: path'],
        [`            value: ${ref('getCustomer.customerId')}`, true],
        ['        successCriteria:'],
        ['          - condition: $statusCode == 200'],
        ["          - condition: $response.body#/status == 'ACTIVE'"],
        ['        outputs:'],
        ['          status: $response.body#/status'],
        ['      - stepId: openAccount'],
        ['        operationId: openAccount'],
        ['        parameters:'],
        ['          - name: Authorization'],
        ['            in: header'],
        [`            value: Bearer {${ref('openAccount.Authorization')}}`, true],
        ['        requestBody:'],
        ['          payload:'],
        [`            customerId: ${ref('openAccount.customerId')}`, true],
        ['        successCriteria:'],
        ['          - condition: $statusCode == 201'],
        ['        outputs:'],
        ['          accountId: $response.body#/accountId'],
        ['    outputs:'],
        ['      accountId: $steps.openAccount.outputs.accountId'],
      ]
      const code = $('.cg-yaml code')
      code.replaceChildren(
        ...lines.map(([l, hl]) => {
          const s = document.createElement('span')
          s.className = hl ? 'cg-line cg-hl' : 'cg-line'
          s.textContent = l
          return s
        }),
      )
      // Las conexiones de getCustomer y openAccount quedan a la vista.
      requestAnimationFrame(() => {
        const pre = code.parentElement!
        const first = code.querySelectorAll<HTMLElement>('.cg-hl')[1]
        if (first) pre.scrollTop = first.offsetTop - pre.offsetTop - 120
      })
      yamlText = lines.map(([l]) => l).join('\n') + '\n'
    }
    $('.cg-copy').addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement
      try {
        await navigator.clipboard.writeText(yamlText)
        b.textContent = T.arazzo.copied
        setTimeout(() => (b.textContent = T.arazzo.copy), 1600)
      } catch {
        /* sin permiso para el portapapeles: el texto sigue a la vista para copiarlo a mano */
      }
    })
    $('.cg-again').addEventListener('click', () => $<HTMLButtonElement>('.cg-reset').click())

    go(0)
  }
</script>

