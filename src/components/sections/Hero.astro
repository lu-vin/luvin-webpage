---
import { strings, type Lang } from '../../i18n/strings'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = strings[lang]
---

<!-- Portada -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="hero-wire" viewBox="0 0 1200 200" preserveAspectRatio="none">
      <path d="M-20 150 C 200 150, 260 60, 420 60 S 700 140, 860 120 S 1080 40, 1220 50" />
      <path class="flow" d="M-20 150 C 200 150, 260 60, 420 60 S 700 140, 860 120 S 1080 40, 1220 50" />
    </svg>
  </div>
  <div class="container hero-copy reveal">
    <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <h1>{t.hero.title1} <span class="accent">{t.hero.title2}</span></h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#waitlist">{t.hero.primary}</a>
      <a class="btn btn-ghost" href="#how">{t.hero.secondary}</a>
    </div>
    <p class="note">{t.hero.note}</p>
  </div>
  <div class="container hero-media reveal">
    <div class="frame">
      <div class="frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <video
        class="promo"
        src={`/media/hero-${lang}.mp4`}
        poster={`/media/hero-poster-${lang}.jpg`}
        aria-label={t.hero.videoLabel}
        controls
        muted
        autoplay
        loop
        playsinline
        preload="metadata"></video>
      <button type="button" class="hero-sound">🔊 {t.hero.sound}</button>
    </div>
  </div>
  <div class="container specs reveal">
    <p class="specs-label">{t.specs.label}</p>
    <ul>
      {t.specs.items.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<script>
  // El video arranca en silencio (así lo permiten los navegadores); el botón lo reinicia con la voz.
  const video = document.querySelector<HTMLVideoElement>('.hero video')
  const sound = document.querySelector<HTMLButtonElement>('.hero-sound')
  if (video && sound) {
    sound.addEventListener('click', () => {
      video.muted = false
      video.currentTime = 0
      void video.play()
      sound.hidden = true
    })
    video.addEventListener('volumechange', () => (sound.hidden = !video.muted))
  }
</script>

<style>
  .hero-sound {
    position: absolute; left: 24px; bottom: 26px; z-index: 2; display: inline-flex; align-items: center; gap: 8px;
    min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .18);
    background: rgba(10, 17, 13, .72); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    color: var(--ink); font: 600 14.5px/1 inherit; font-family: inherit; cursor: pointer;
  }
  .hero-sound:hover { background: rgba(10, 17, 13, .9); }
  .hero-sound[hidden] { display: none; }
  @media (max-width: 600px) {
    .hero-sound { left: 14px; bottom: 16px; min-height: 34px; font-size: 13px; }
  }
</style>
