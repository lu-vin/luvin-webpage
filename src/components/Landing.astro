---
import { strings, type Lang } from '../i18n/strings'
import Icon from './Icon.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = strings[lang]
const media = lang === 'en' ? '/media' : '/media/es'
// Capturas y videos de la app actual (los mismos de la documentación), en el idioma de la página.
const app = `/media/app/${lang}`
const tools = [
  { key: 'luvin', name: 'Luvin', icon: '/logo.svg' },
  { key: 'postman', name: 'Postman', icon: '/media/postman.svg' },
  { key: 'bruno', name: 'Bruno', icon: '/media/bruno.svg' },
  { key: 'insomnia', name: 'Insomnia', icon: '/media/insomnia.svg' },
] as const
---

<!-- Portada -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <svg class="hero-wire" viewBox="0 0 1200 200" preserveAspectRatio="none">
      <path d="M-20 150 C 200 150, 260 60, 420 60 S 700 140, 860 120 S 1080 40, 1220 50" />
      <path class="flow" d="M-20 150 C 200 150, 260 60, 420 60 S 700 140, 860 120 S 1080 40, 1220 50" />
    </svg>
  </div>
  <div class="container hero-copy reveal">
    <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <h1>{t.hero.title1} <span class="accent">{t.hero.title2}</span></h1>
    <p class="lead">{t.hero.lead}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#waitlist">{t.hero.primary}</a>
      <a class="btn btn-ghost" href="#how">{t.hero.secondary}</a>
    </div>
    <p class="note">{t.hero.note}</p>
  </div>
  <div class="container hero-media reveal">
    <div class="frame">
      <div class="frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <video
        class="promo"
        src="/media/promo.mp4"
        poster="/media/promo-poster.jpg"
        aria-label={t.hero.videoLabel}
        controls
        muted
        autoplay
        loop
        playsinline
        preload="metadata"></video>
    </div>
  </div>
  <div class="container specs reveal">
    <p class="specs-label">{t.specs.label}</p>
    <ul>
      {t.specs.items.map((s) => <li>{s}</li>)}
    </ul>
  </div>
</section>

<!-- El problema -->
<section id="problem" class="section">
  <div class="container narrow center reveal">
    <p class="kicker">{t.problem.kicker}</p>
    <h2>{t.problem.title}</h2>
    <p class="body">{t.problem.body}</p>
  </div>
  <div class="container reveal">
    <img class="chain" src={`${media}/chain-dark.svg`} alt={t.problem.chainAlt} width="1280" height="430" loading="lazy" />
    <p class="answer">{t.problem.answer}</p>
  </div>
</section>

<!-- Cómo funciona -->
<section id="how" class="section alt">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{t.how.kicker}</p>
      <h2>{t.how.title}</h2>
    </div>
    <ol class="steps reveal">
      {
        t.how.steps.map((s, i) => (
          <li class="step">
            <span class="step-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="showcase">
      {
        t.showcase.map((s, i) => (
          <div class={`show-row reveal ${i % 2 ? 'reverse' : ''}`}>
            <div class="show-copy">
              <span class="show-num">0{i + 1}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
            <div class="shot">
              {s.video ? (
                <video data-autoplay src={`${app}/${s.img}.mp4`} poster={`${app}/${s.img}.webp`} aria-label={s.alt} muted loop playsinline preload="none" />
              ) : (
                <img src={`${app}/${s.img}.webp`} alt={s.alt} width="1600" height="1000" loading="lazy" />
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Cadenas reales -->
<section id="chains" class="section">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{t.chains.kicker}</p>
      <h2>{t.chains.title}</h2>
      <p class="body">{t.chains.lead}</p>
    </div>
    <div class="bento">
      <article class="tile tile-pick reveal">
        <div class="tile-copy">
          <p class="tag"><Icon name="list" size={16} />{t.chains.pick.tag}</p>
          <h3>{t.chains.pick.title}</h3>
          <p>{t.chains.pick.body}</p>
        </div>
        <div class="tile-media">
          <video data-autoplay src={`${app}/list-pick.mp4`} poster={`${app}/list-pick.webp`} aria-label={t.chains.pick.alt} muted loop playsinline preload="none"></video>
        </div>
      </article>
      <article class="tile tile-deps reveal">
        <div class="tile-copy">
          <p class="tag"><Icon name="nest" size={16} />{t.chains.deps.tag}</p>
          <h3>{t.chains.deps.title}</h3>
          <p>{t.chains.deps.body}</p>
        </div>
        <div class="tile-media crop">
          <img src={`${app}/builder-depends.webp`} alt={t.chains.deps.alt} width="1600" height="1000" loading="lazy" />
        </div>
      </article>
      {
        t.chains.items.map((c) => (
          <article class="tile tile-small reveal">
            <span class="ico"><Icon name={c.icon} /></span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Cliente de APIs -->
<section id="client" class="section alt">
  <div class="container client">
    <div class="client-copy reveal">
      <p class="kicker">{t.client.kicker}</p>
      <h2>{t.client.title}</h2>
      <p class="body">{t.client.lead}</p>
      <ul class="client-list">
        {
          t.client.items.map((c) => (
            <li>
              <span class="ico"><Icon name={c.icon} /></span>
              <div>
                <h3>{c.title}</h3>
                <p>{c.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="client-media reveal">
      <img class="shot-back" src={`${app}/import-postman.webp`} alt={t.client.altImport} width="1600" height="1000" loading="lazy" />
      <img class="shot-front" src={`${app}/request.webp`} alt={t.client.alt} width="1600" height="1000" loading="lazy" />
    </div>
  </div>
  <div class="container auth reveal">
    <p class="auth-title"><Icon name="shield" size={18} />{t.client.authTitle}</p>
    <ul class="chips">
      {t.client.auths.map((a) => <li>{a}</li>)}
    </ul>
  </div>
</section>

<!-- Comparación -->
<section id="compare" class="section">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{t.compare.kicker}</p>
      <h2>{t.compare.title}</h2>
      <p class="body">{t.compare.lead}</p>
    </div>
    <div class="table-wrap reveal">
      <table class="compare">
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">—</span></th>
            {
              tools.map((tool) => (
                <th scope="col" class={tool.key === 'luvin' ? 'us' : ''}>
                  <img src={tool.icon} width="30" height="30" alt="" />
                  <span>{tool.name}</span>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            t.compare.rows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                <td class="us">
                  <span class="check" aria-hidden="true">✓</span>
                  {row.luvin}
                </td>
                <td>{row.postman}</td>
                <td>{row.bruno}</td>
                <td>{row.insomnia}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="vs-teaser reveal">
      <img src="/media/postman.svg" width="40" height="40" alt="" />
      <div class="vs-teaser-copy">
        <p class="vs-q">{t.flows.homeQuestion}</p>
        <p>{t.flows.lead}</p>
      </div>
      <a class="btn btn-ghost" href={`${lang === 'en' ? '/' : '/es/'}compare/postman-flows/`}>{t.flows.homeLink} →</a>
    </div>
    <p class="fine center">{t.compare.note}</p>
  </div>
</section>

<!-- Funciones -->
<section id="features" class="section alt">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{t.features.kicker}</p>
      <h2>{t.features.title}</h2>
    </div>
    <div class="grid-3">
      {
        t.features.items.map((f) => (
          <div class="card feature reveal">
            <span class="ico"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Para quién es -->
<section class="section">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{t.who.kicker}</p>
      <h2>{t.who.title}</h2>
    </div>
    <div class="grid-2">
      {
        t.who.items.map((w) => (
          <div class="card who reveal">
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- Preguntas -->
<section id="faq" class="section alt">
  <div class="container faq">
    <div class="faq-head reveal">
      <p class="kicker">{t.faq.kicker}</p>
      <h2>{t.faq.title}</h2>
    </div>
    <div class="faq-list reveal">
      {
        t.faq.items.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<!-- Founders -->
<section id="founders" class="section">
  <div class="container">
    <div class="center narrow reveal">
      <p class="kicker">{t.founders.kicker}</p>
      <h2>{t.founders.title}</h2>
      <p class="body">{t.founders.story}</p>
    </div>
    <div class="grid-2 founders">
      {
        t.founders.people.map((f) => (
          <article class="card founder reveal">
            <img class="founder-photo" src={f.photo} width="160" height="160" alt={f.name} loading="lazy" decoding="async" />
            <h3>{f.name}</h3>
            <p class="founder-role">{f.role}</p>
            <p>{f.bio}</p>
            <p class="founder-off">{f.off}</p>
            <a class="founder-link" href={f.linkedin} target="_blank" rel="noopener noreferrer">
              {t.founders.linkedin} ↗
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Lista de espera -->
<section id="waitlist" class="section waitlist">
  <div class="container narrow center">
    <img class="wl-logo" src="/logo.svg" width="64" height="64" alt="" />
    <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>{t.hero.eyebrow}</p>
    <h2>{t.waitlist.title}</h2>
    <p class="body">{t.waitlist.lead}</p>
    <form class="wl-form" data-thanks={t.waitlist.thanks} data-error={t.waitlist.error} data-soon={t.waitlist.soon} data-sending={t.waitlist.sending}>
      <input type="hidden" name="lang" value={lang} />
      <div class="wl-hp" aria-hidden="true">
        <label for="wl-website">Website</label>
        <input id="wl-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </div>
      <div class="wl-grid">
        <label class="wl-field">
          <span>{t.waitlist.name}</span>
          <input name="name" type="text" required maxlength="120" autocomplete="name" placeholder={t.waitlist.namePlaceholder} />
        </label>
        <label class="wl-field">
          <span>{t.waitlist.label}</span>
          <input name="email" type="email" required maxlength="254" autocomplete="email" placeholder={t.waitlist.placeholder} />
        </label>
        <label class="wl-field">
          <span>{t.waitlist.company}</span>
          <input name="company" type="text" maxlength="160" autocomplete="organization" placeholder={t.waitlist.companyPlaceholder} />
        </label>
        <label class="wl-field">
          <span>{t.waitlist.role}</span>
          <select name="role" required>
            <option value="" disabled selected>{t.waitlist.rolePlaceholder}</option>
            {t.waitlist.roles.map((r) => <option value={r}>{r}</option>)}
          </select>
        </label>
        <label class="wl-field wl-wide">
          <span>{t.waitlist.useCase}</span>
          <textarea name="useCase" rows="3" maxlength="2000" placeholder={t.waitlist.useCasePlaceholder}></textarea>
        </label>
      </div>
      <button class="btn btn-primary" type="submit">{t.waitlist.button}</button>
      <p class="wl-privacy">{t.waitlist.privacy}</p>
    </form>
    <p class="wl-status" role="status" aria-live="polite"></p>
  </div>
</section>

<script>
  // Envía el formulario a /api/waitlist, que manda el correo de bienvenida con todo sobre Luvin.
  const form = document.querySelector<HTMLFormElement>('.wl-form')
  const status = document.querySelector<HTMLElement>('.wl-status')
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    if (!status) return
    const { thanks, error, soon, sending } = form.dataset
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')
    if (button) button.disabled = true
    status.dataset.state = ''
    status.textContent = sending ?? ''
    try {
      const res = await fetch('/api/waitlist', { method: 'POST', headers: { Accept: 'application/json' }, body: new FormData(form) })
      const data = await res.json().catch(() => ({}))
      if (res.ok && data.ok) {
        status.textContent = thanks ?? ''
        form.reset()
      } else {
        status.dataset.state = data.error === 'not_configured' ? '' : 'error'
        status.textContent = (data.error === 'not_configured' ? soon : error) ?? ''
      }
    } catch {
      status.dataset.state = 'error'
      status.textContent = error ?? ''
    } finally {
      if (button) button.disabled = false
    }
  })

  // Lo que entra en pantalla aparece con una animación corta, y los videos de la app se reproducen
  // solo mientras se ven (así no se descargan todos al abrir la página).
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
  document.documentElement.classList.add('js')
  const seen = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue
        e.target.classList.add('in')
        seen.unobserve(e.target)
      }
    },
    { rootMargin: '0px 0px -8% 0px' },
  )
  document.querySelectorAll('.reveal').forEach((el) => seen.observe(el))
  const clips = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement
        if (e.isIntersecting && !reduced) void v.play().catch(() => {})
        else v.pause()
      }
    },
    { threshold: 0.35 },
  )
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
    if (reduced) v.controls = true
    clips.observe(v)
  })
</script>
