---
// Encabezado de una página interior: kicker, título (h1) y entrada.
interface Props {
  kicker: string
  title: string
  lead?: string
}
const { kicker, title, lead } = Astro.props
---

<section class="page-head">
  <div class="container narrow center reveal">
    <p class="kicker">{kicker}</p>
    <h1>{title}</h1>
    {lead && <p class="body">{lead}</p>}
  </div>
</section>
